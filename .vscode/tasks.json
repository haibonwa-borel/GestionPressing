{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "mvn-compile",
      "type": "shell",
      "command": ".\\mvnw",
      "args": ["clean", "compile", "-q"],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Spring Boot: Run",
      "type": "shell",
      "command": ".\\mvnw",
      "args": ["clean", "spring-boot:run"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
